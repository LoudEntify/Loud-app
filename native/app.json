{
  "expo": {
    "name": "Loudentify",
    "slug": "loudentify",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "loudentify",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#011627",
    "ios": {
      "bundleIdentifier": "app.loudentify.ios",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Loudentify uses the camera so this phone can be a camera for your show.",
        "NSMicrophoneUsageDescription": "Loudentify uses the microphone for your show's sound.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "associatedDomains": [
        "applinks:loudentify.app"
      ],
      "bitcode": false
    },
    "android": {
      "package": "app.loudentify.android",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "loudentify.app",
              "pathPrefix": "/show"
            },
            {
              "scheme": "https",
              "host": "loudentify.app",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "loudentify.app",
              "pathPrefix": "/clip"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Loudentify uses the camera so this phone can be a camera for your show.",
          "microphonePermission": "Loudentify uses the microphone for your show's sound."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "expo-camera",
        {
          "cameraPermission": "Loudentify uses the camera so this phone can be a camera for your show."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#011627"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ]
    ],
    "extra": {
      "apiBase": "https://loudentify.app",
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "03471d38-9e8d-4c78-b438-470aea22ce2e"
      },
      "router": {},
      "expo-status-bar": {
        "style": "light"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "loudentifymain"
  }
}
