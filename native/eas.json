{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_API_BASE": "https://loud-app-git-staging-korey-alashe.vercel.app" } },
    "preview": { "distribution": "internal", "ios": { "simulator": false }, "android": { "buildType": "apk" }, "env": { "EXPO_PUBLIC_API_BASE": "https://loud-app-git-staging-korey-alashe.vercel.app" } },
    "production": { "autoIncrement": true, "env": { "EXPO_PUBLIC_API_BASE": "https://loudentify.app" } }
  },
  "submit": {
    "production": { "ios": { "appleId": "SET-ME", "ascAppId": "SET-ME", "appleTeamId": "SET-ME" }, "android": { "serviceAccountKeyPath": "./google-play-service-account.json", "track": "internal" } }
  }
}
