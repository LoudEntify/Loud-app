# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore — never commit actual keys/secrets.

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://yourproject.livekit.cloud

# Read by lib/supabaseClient.js (anon key, safe to expose client-side --
# RLS is what actually restricts access on tables it can reach).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Read by lib/supabaseAdmin.js ONLY -- server-side only, bypasses RLS
# entirely. Never prefix this NEXT_PUBLIC_. See MULTI_PERFORMER_SPEC.md.
SUPABASE_SERVICE_ROLE_KEY=

# Device-zoom spike, LOCAL CONTROLLER ONLY (app/spike/controller, branch
# spike/native-device-zoom): make this server's /api/spike/clock relay the
# staging deployment's clock, so the laptop and the phone (which talks to
# staging) stamp one time reference. Ignored on Vercel. Leave empty otherwise.
NEXT_PUBLIC_SPIKE_CLOCK_BASE=
