# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore — never commit actual keys/secrets.

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://yourproject.livekit.cloud

# Read by lib/supabaseClient.js (anon key, safe to expose client-side --
# RLS is what actually restricts access on tables it can reach).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Read by lib/supabaseAdmin.js ONLY -- server-side only, bypasses RLS
# entirely. Never prefix this NEXT_PUBLIC_. See MULTI_PERFORMER_SPEC.md.
SUPABASE_SERVICE_ROLE_KEY=


YOUTUBE_LIVE_ENABLED=true
NEXT_PUBLIC_EXP_VD_001_ENABLED=false
# off | shadow | active. Keep shadow until EXP-VD-002 evidence is reviewed.
NEXT_PUBLIC_EXP_VD_002_MODE=off
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
YOUTUBE_OAUTH_REDIRECT_URI=https://your-domain/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=...
